// Shockwave Effect - Iridescent radial ring with chromatic aberration and UV warp
// On open: a rainbow shockwave expands from the window center, revealing content in its wake.
// On close: the ring contracts inward, consuming the window as it shrinks.
//
// Adjustable parameters:
// - ring_width (0.06):  Width of the iridescent glow ring at the wavefront
// - ca       (0.012):  Chromatic aberration intensity at wavefront
// - warp     (0.025):  UV distortion intensity at wavefront

animations {
    window-open {
        duration-ms 500
        curve "ease-out-expo"
        custom-shader r"
            vec4 open_color(vec3 coords_geo, vec3 size_geo) {
                float p0 = niri_clamped_progress;
                // Extra smoothstep on top of the outer easing curve
                float p = p0 * p0 * (3.0 - 2.0 * p0);

                vec2 uv = coords_geo.xy;
                if (uv.x < 0.0 || uv.x > 1.0 || uv.y < 0.0 || uv.y > 1.0)
                    return vec4(0.0);

                vec2 center = vec2(0.5);
                float aspect = size_geo.x / size_geo.y;

                // Aspect-corrected vector/distance from center
                vec2 from_center = (uv - center) * vec2(aspect, 1.0);
                float dist  = length(from_center);
                float angle = atan(from_center.y, from_center.x);

                // Radius that covers the farthest corner
                float max_dist = length(vec2(aspect * 0.5, 0.5));

                // Expanding wavefront
                float wave = p * (max_dist + 0.08);

                // Pixels ahead of the wave have not yet been reached — invisible
                if (dist > wave) return vec4(0.0);

                float behind = wave - dist;   // 0 at the ring, grows toward center

                // --- UV warp (ripple distortion just behind the wavefront) ---
                float warp_amt = exp(-behind * 10.0) * 0.025 * (1.0 - p0);
                vec2 warp_dir  = normalize(from_center + vec2(0.0001)) / vec2(aspect, 1.0);
                vec2 w_uv      = clamp(uv - warp_dir * warp_amt, 0.001, 0.999);

                // --- Chromatic aberration just behind the wavefront ---
                float ca_amt = exp(-behind * 8.0) * 0.012 * (1.0 - p0);
                vec2 ca_dir  = warp_dir * ca_amt;

                vec3 tc_r = niri_geo_to_tex * vec3(clamp(w_uv + ca_dir, 0.001, 0.999), 1.0);
                vec3 tc_g = niri_geo_to_tex * vec3(w_uv,                                1.0);
                vec3 tc_b = niri_geo_to_tex * vec3(clamp(w_uv - ca_dir, 0.001, 0.999), 1.0);

                float r = texture2D(niri_tex, tc_r.st).r;
                float g = texture2D(niri_tex, tc_g.st).g;
                float b = texture2D(niri_tex, tc_b.st).b;
                float a = texture2D(niri_tex, tc_g.st).a;
                vec3 color = vec3(r, g, b);

                // --- Iridescent glow ring at the wavefront ---
                float ring_width = 0.06;
                if (behind < ring_width) {
                    float t    = behind / ring_width;
                    float glow = (1.0 - t) * (1.0 - t);   // bright at wave, fades behind

                    // Rainbow hue mapped around the ring angle
                    float hue = fract(angle / 6.28318 + 0.5) * 6.0;
                    float hi  = floor(hue);
                    float f   = hue - hi;
                    vec3 rainbow;
                    if      (hi < 1.0) rainbow = vec3(1.0,     f,   0.0);
                    else if (hi < 2.0) rainbow = vec3(1.0 - f, 1.0, 0.0);
                    else if (hi < 3.0) rainbow = vec3(0.0,     1.0, f  );
                    else if (hi < 4.0) rainbow = vec3(0.0, 1.0 - f, 1.0);
                    else if (hi < 5.0) rainbow = vec3(f,       0.0, 1.0);
                    else               rainbow = vec3(1.0,     0.0, 1.0 - f);

                    color = mix(color, vec3(1.0), glow * 0.55);
                    color += rainbow * glow * 0.45;
                }

                // Quick alpha fade-in just behind the wavefront
                float fade = min(behind / (max_dist * 0.12), 1.0);

                return vec4(color, a * fade);
            }
        "
    }

    window-close {
        duration-ms 420
        curve "ease-out-quad"
        custom-shader r"
            vec4 close_color(vec3 coords_geo, vec3 size_geo) {
                float p0 = niri_clamped_progress;
                float p  = p0 * p0 * (3.0 - 2.0 * p0);

                vec2 uv = coords_geo.xy;
                if (uv.x < 0.0 || uv.x > 1.0 || uv.y < 0.0 || uv.y > 1.0)
                    return vec4(0.0);

                vec2 center = vec2(0.5);
                float aspect = size_geo.x / size_geo.y;

                vec2 from_center = (uv - center) * vec2(aspect, 1.0);
                float dist  = length(from_center);
                float angle = atan(from_center.y, from_center.x);

                float max_dist = length(vec2(aspect * 0.5, 0.5));

                // Contracting wavefront — starts at max_dist, shrinks to zero
                float wave = (1.0 - p) * (max_dist + 0.08);

                // Pixels outside the contracting ring have already been consumed
                if (dist > wave) return vec4(0.0);

                float behind = wave - dist;

                // --- UV warp just inside the wavefront ---
                float warp_amt = exp(-behind * 10.0) * 0.025 * p0;
                vec2 warp_dir  = normalize(from_center + vec2(0.0001)) / vec2(aspect, 1.0);
                vec2 w_uv      = clamp(uv - warp_dir * warp_amt, 0.001, 0.999);

                // --- Chromatic aberration ---
                float ca_amt = exp(-behind * 8.0) * 0.012 * p0;
                vec2 ca_dir  = warp_dir * ca_amt;

                vec3 tc_r = niri_geo_to_tex * vec3(clamp(w_uv + ca_dir, 0.001, 0.999), 1.0);
                vec3 tc_g = niri_geo_to_tex * vec3(w_uv,                                1.0);
                vec3 tc_b = niri_geo_to_tex * vec3(clamp(w_uv - ca_dir, 0.001, 0.999), 1.0);

                float r = texture2D(niri_tex, tc_r.st).r;
                float g = texture2D(niri_tex, tc_g.st).g;
                float b = texture2D(niri_tex, tc_b.st).b;
                float a = texture2D(niri_tex, tc_g.st).a;
                vec3 color = vec3(r, g, b);

                // --- Iridescent glow ring at contracting wavefront ---
                float ring_width = 0.06;
                if (behind < ring_width) {
                    float t    = behind / ring_width;
                    float glow = (1.0 - t) * (1.0 - t);

                    float hue = fract(angle / 6.28318 + 0.5) * 6.0;
                    float hi  = floor(hue);
                    float f   = hue - hi;
                    vec3 rainbow;
                    if      (hi < 1.0) rainbow = vec3(1.0,     f,   0.0);
                    else if (hi < 2.0) rainbow = vec3(1.0 - f, 1.0, 0.0);
                    else if (hi < 3.0) rainbow = vec3(0.0,     1.0, f  );
                    else if (hi < 4.0) rainbow = vec3(0.0, 1.0 - f, 1.0);
                    else if (hi < 5.0) rainbow = vec3(f,       0.0, 1.0);
                    else               rainbow = vec3(1.0,     0.0, 1.0 - f);

                    color = mix(color, vec3(1.0), glow * 0.55);
                    color += rainbow * glow * 0.45;
                }

                // Fade out just inside wavefront as it shrinks to nothing
                float fade = min(behind / (max_dist * 0.12), 1.0);

                return vec4(color, a * fade);
            }
        "
    }
}
