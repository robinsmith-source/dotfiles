// VHS Tracking Glitch
// Open:  window arrives like a VHS tape locking in — starts with heavy tracking
//        errors (horizontal row jitter, Y/C chroma bleed, luma noise bands) and
//        settles into a clean signal as progress reaches 1.
// Close: clean signal degrades back into tracking chaos as the window closes.
//
// This is distinct from glitch.kdl (which does RGB channel split + CRT lines).
// Here the artefacts simulate magnetic tape physics:
//   - Per-row horizontal displacement  (head/tape contact jitter)
//   - Y/C delay (luma and chroma in separate channels on tape)
//   - Dropout noise bands  (oxide coating irregularities)
//   - CRT interlace lines  (period-accurate display)
//
// Adjustable:
// - LINES  (200.0): number of simulated VHS scan lines (lower = chunkier)
// - JITTER (0.07):  max per-row horizontal offset at full glitch strength
// - CHROMA (0.028): Y/C chroma bleed distance at full glitch
// - NOISE  (0.22):  noise band intensity at full glitch

animations {
    window-open {
        duration-ms 580
        curve "linear"
        custom-shader r"
            // Fast scalar hash (no trig, cheaper on GPU)
            float h1(float n) { return fract(n * 0.1031 * (n * 0.103 + 33.33)); }
            float h2(float n) { return fract(n * 0.1030 * (n * 0.311 + 17.17)); }

            vec4 open_color(vec3 coords_geo, vec3 size_geo) {
                float p0 = niri_clamped_progress;

                vec2 uv = coords_geo.xy;
                if (uv.x < 0.0 || uv.x > 1.0 || uv.y < 0.0 || uv.y > 1.0)
                    return vec4(0.0);

                float glitch = 1.0 - p0;   // 1 at start, 0 when fully open

                // ── Per-row seed ───────────────────────────────────────────────
                // Quantise progress into ~45 discrete "tape frames" for
                // animated noise without a time uniform.
                float frame = floor(p0 * 45.0);
                float row   = floor(uv.y * 200.0);    // LINES = 200

                float r1 = h1(row + frame * 127.1);   // row jitter seed
                float r2 = h2(row + frame *  53.3);   // noise band seed

                // ── Horizontal tracking jitter ─────────────────────────────────
                float jitter = (r1 - 0.5) * 0.07 * glitch;

                // Sync-loss bands: periodic Y zones with extra jitter
                float band_env = max(0.0, sin(uv.y * 18.0 + glitch * 12.0));
                jitter += (r2 - 0.5) * band_env * 0.045 * glitch;

                vec2 j_uv = vec2(uv.x + jitter, uv.y);

                // ── Y/C chroma bleed (luma and colour on separate tape channels)
                float ca = glitch * 0.028;
                vec3 tc_y = niri_geo_to_tex * vec3(j_uv,                         1.0);
                vec3 tc_r = niri_geo_to_tex * vec3(j_uv + vec2( ca * 1.0, 0.0),  1.0);
                vec3 tc_b = niri_geo_to_tex * vec3(j_uv + vec2(-ca * 0.6, 0.0),  1.0);

                float r_ch = texture2D(niri_tex, tc_r.st).r;
                float g_ch = texture2D(niri_tex, tc_y.st).g;
                float b_ch = texture2D(niri_tex, tc_b.st).b;
                float alpha = texture2D(niri_tex, tc_y.st).a;
                vec3 color = vec3(r_ch, g_ch, b_ch);

                // ── Dropout noise bands ────────────────────────────────────────
                float dropout = h1(row * 7.3 + frame * 3.7);
                float band_strength = max(0.0, sin(uv.y * 38.0 + glitch * 60.0))
                                    * glitch * 0.22;
                color = mix(color, vec3(dropout), band_strength);

                // ── Interlace scanlines ────────────────────────────────────────
                float scan = mod(floor(uv.y * size_geo.y), 2.0);
                color *= (scan < 0.5) ? 0.84 : 1.0;

                // ── Slight desaturation on heavy-glitch frames ─────────────────
                float luma = dot(color, vec3(0.299, 0.587, 0.114));
                color = mix(vec3(luma), color, 0.65 + 0.35 * p0);

                return vec4(color, alpha * p0);
            }
        "
    }

    window-close {
        duration-ms 680
        curve "linear"
        custom-shader r"
            float h1(float n) { return fract(n * 0.1031 * (n * 0.103 + 33.33)); }
            float h2(float n) { return fract(n * 0.1030 * (n * 0.311 + 17.17)); }

            vec4 close_color(vec3 coords_geo, vec3 size_geo) {
                float p0 = niri_clamped_progress;

                vec2 uv = coords_geo.xy;
                if (uv.x < 0.0 || uv.x > 1.0 || uv.y < 0.0 || uv.y > 1.0)
                    return vec4(0.0);

                float glitch = p0;   // 0 when fully open, 1 when fully closed

                float frame = floor(p0 * 45.0);
                float row   = floor(uv.y * 200.0);

                float r1 = h1(row + frame * 127.1);
                float r2 = h2(row + frame *  53.3);

                // Horizontal tracking jitter
                float jitter = (r1 - 0.5) * 0.07 * glitch;
                float band_env = max(0.0, sin(uv.y * 18.0 + glitch * 12.0));
                jitter += (r2 - 0.5) * band_env * 0.045 * glitch;

                vec2 j_uv = vec2(uv.x + jitter, uv.y);

                // Y/C chroma bleed
                float ca = glitch * 0.028;
                vec3 tc_y = niri_geo_to_tex * vec3(j_uv,                         1.0);
                vec3 tc_r = niri_geo_to_tex * vec3(j_uv + vec2( ca * 1.0, 0.0),  1.0);
                vec3 tc_b = niri_geo_to_tex * vec3(j_uv + vec2(-ca * 0.6, 0.0),  1.0);

                float r_ch = texture2D(niri_tex, tc_r.st).r;
                float g_ch = texture2D(niri_tex, tc_y.st).g;
                float b_ch = texture2D(niri_tex, tc_b.st).b;
                float alpha = texture2D(niri_tex, tc_y.st).a;
                vec3 color = vec3(r_ch, g_ch, b_ch);

                // Dropout noise bands
                float dropout = h1(row * 7.3 + frame * 3.7);
                float band_strength = max(0.0, sin(uv.y * 38.0 + glitch * 60.0))
                                    * glitch * 0.22;
                color = mix(color, vec3(dropout), band_strength);

                // Interlace scanlines
                float scan = mod(floor(uv.y * size_geo.y), 2.0);
                color *= (scan < 0.5) ? 0.84 : 1.0;

                // Desaturation increases as signal degrades
                float luma = dot(color, vec3(0.299, 0.587, 0.114));
                color = mix(vec3(luma), color, 0.65 + 0.35 * (1.0 - p0));

                return vec4(color, alpha * (1.0 - p0));
            }
        "
    }
}
