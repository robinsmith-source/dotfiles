# Ignore everything by default — only track explicitly added files.
# This prevents accidentally staging sensitive files from $HOME.
*

# Allow tracked files and directories
!.gitignore
!install.sh
!update.sh
!.github/
!.github/**
!.config/
!.config/**

# Claude Code local settings (machine-specific)
.claude/

# Dynamic theme outputs (generated by matugen / noctalia at runtime)
# Track templates/inputs instead, not these derived files.
.config/nvim/lua/matugen.lua
.config/noctalia/colors.json
