{{- if eq .chezmoi.os "linux" -}}
#!/usr/bin/env bash
set -euo pipefail

PACMAN_PKGS=(
{{- range .packages.pacman }}
    {{ . | quote }}
{{- end }}
{{- if .laptop }}
{{- range .packages.pacman_laptop }}
    {{ . | quote }}
{{- end }}
{{- end }}
{{- if eq .chezmoi.osRelease.id "cachyos" }}
{{- range .packages.pacman_cachyos }}
    {{ . | quote }}
{{- end }}
{{- end }}
)

AUR_PKGS=(
{{- range .packages.aur }}
    {{ . | quote }}
{{- end }}
)

missing() {  # missing <array...> — prints only the ones not currently installed
    for pkg in "$@"; do
        pacman -Q "$pkg" &>/dev/null || echo "$pkg"
    done
}

pacman_missing=($(missing "${PACMAN_PKGS[@]}"))
aur_missing=()
if [[ ${#AUR_PKGS[@]} -gt 0 ]]; then
    aur_missing=($(missing "${AUR_PKGS[@]}"))
fi

total=$(( ${#pacman_missing[@]} + ${#aur_missing[@]} ))
if [[ $total -eq 0 ]]; then
    exit 0
fi

if command -v gum &>/dev/null; then
    gum style --bold --foreground 212 "$total package(s) to install:"
    printf '%s\n' "${pacman_missing[@]}" "${aur_missing[@]}" | gum style --foreground 42 --padding "0 2"
    gum confirm "Install now?" || exit 0
else
    echo "$total package(s) to install:"
    printf '  + %s\n' "${pacman_missing[@]}" "${aur_missing[@]}"
    read -rp "Install now? [Y/n]: " reply
    [[ -z $reply || ${reply,,} == y* ]] || exit 0
fi

if [[ ${#pacman_missing[@]} -gt 0 ]]; then
    sudo pacman -S --needed --noconfirm "${pacman_missing[@]}"
fi

if [[ ${#aur_missing[@]} -gt 0 ]]; then
    if command -v paru &>/dev/null; then
        AUR=paru
    elif command -v yay &>/dev/null; then
        AUR=yay
    else
        AUR=""
    fi

    if [[ -n $AUR ]]; then
        $AUR -S --needed --noconfirm "${aur_missing[@]}"
    else
        echo "No AUR helper found — skipping: ${aur_missing[*]}" >&2
    fi
fi
{{ end -}}
