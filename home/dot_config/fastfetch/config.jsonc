{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "modules": [
    "break",
    "break",
    "break",
    "break",
    "title",
    "separator",
    "os",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "wm",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    "disk",
    "break",
    "colors"
  ],
  "logo": {
    "type": "file-raw",
    "source": "$HOME/.config/fastfetch/logo.txt"
  },
  "display": {
    "color": {
      "keys": "#33b1ff",
      "title": "#42be65"
    },
    "percent": {
      "color": {
        "green": "#be95ff",
        "yellow": "#80ceff",
        "red": "#ee5396"
      }
    }
  }
}
