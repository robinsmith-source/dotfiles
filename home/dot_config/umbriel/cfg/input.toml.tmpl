[input.keyboard]
numlock_toggle = true
{{- if .laptop }}
layout = "de,us"
variant = ",intl"
options = "grp:win_space_toggle,ctrl:nocaps"
{{- else }}
layout = "us"
variant = "altgr-intl"
{{- end }}

[input.mouse]
accel_profile = "flat"
sensitivity = 0.0

[input.touchpad]
tap = true
natural_scroll = true

[input.focus]
follows_mouse = true
{{- if not .laptop }}
follows_mouse_max_scroll = 0.0
{{- end }}

[input.cursor]
theme = "capitaine-cursors"
size = 24

[input.drag_edge_scroll]
trigger_zone = 30
delay_ms = 50
max_speed = 1500
