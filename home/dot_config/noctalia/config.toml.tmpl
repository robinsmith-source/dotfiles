[dock]
background_opacity = 1.0
concave_edge_corners = false
enabled = true
icon_size = 42
pinned = [ "zen", "dev.zed.Zed", "spotify-launcher", "discord" ]
radius = 0
radius_top_left = 8
radius_top_right = 8
reserve_space = false
shadow = true
show_dots = true
smart_auto_hide = true

[idle]
behavior_order = [ "lock", "screen-off", "lock-and-suspend" ]

