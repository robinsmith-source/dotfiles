[bar.default]
capsule = true
capsule_radius = 4
capsule_thickness = 0.8
center = [ "taskbar" ]
concave_edge_corners = false
end = [ "media", "tray", "group:g4", "group:g2", "volume",{{ if .laptop }} "group:g5",{{ end }} "session" ]
font_family = "JetBrainsMono NF"
margin_ends = 0
padding = 4
radius = 0
start = [ "clock", "group:g1", "group:g3" ]

