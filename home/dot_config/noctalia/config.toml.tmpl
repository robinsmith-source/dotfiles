[nightlight]
temperature_night = 6400

[notification]
filter_order = [ "filter" ]

    [notification.filter.filter]
    allow_permanent = true
    bypass_dnd = false
    enabled = true
    match = "spotify"
    play_sound = true
    save_history = true
    show_toast = true

[osd]
position = "bottom_center"
position_vertical = "bottom_center"

    [osd.kinds]
    keyboard_backlight = false
    lock_keys = false
    media = false
    power_profile = false

[plugin_settings."kenn/keybind-cheatsheet"]
compositor = "niri"

[plugin_settings."noctalia/wallhaven"]
download_dir = "{{ .chezmoi.homeDir }}/Pictures/Wallpaper"

[plugin_settings."noctalia/wallpaper_depth"]
feather = 15
threshold = 55

[plugin_settings."raycursive/niri-displays"]
scale_presets = [ "2560x1440=1", "3840x2160=1.5" ]

[plugin_settings."robin/keyboard_color_sync"]
hue_shift = 105

[plugins]
auto_update = "official"
enabled = [ "noctalia/bitwarden", "noctalia/wallhaven" ]

    [[plugins.source]]
    kind = "git"
    location = "https://github.com/noctalia-dev/official-plugins"
    name = "official"

    [[plugins.source]]
    kind = "git"
    location = "https://github.com/noctalia-dev/community-plugins"
    name = "community"

    [[plugins.source]]
    kind = "path"
    location = "{{ .chezmoi.homeDir }}/code/qmk-color-sync"
    name = "local"

[shell]
corner_radius_scale = 0.5
font_family = "JetBrainsMono NF"
niri_overview_type_to_launch_enabled = true
polkit_agent = true
screen_time_enabled = true

    [shell.launcher]
    app_grid = false
    pinned = [ "dev.zed.Zed", "bitwarden", "discord", "spotify-launcher" ]

    [shell.panel]
    clipboard_placement = "attached"
    open_near_click_clipboard = true
    open_near_click_control_center = true
    open_near_click_launcher = false
    open_near_click_session = true
    open_near_click_wallpaper = true
    transparency_mode = "solid"

    [shell.screen_corners]
    enabled = true
    size = 8

    [shell.screenshot]
    confirm_region = true
    remember_last_region = true

    [shell.session]
    grid = true
    show_shortcuts = false

[theme]
builtin = "Kanagawa"
community_palette = "Oxocarbon"
mode = "dark"
source = "community"
wallpaper_scheme = "m3-tonal-spot"

    [theme.templates]
    builtin_ids = [ "alacritty", "btop", "cava", "gtk3", "gtk4", "niri", "qt", "starship" ]
    community_ids = [
        "claude-code",
        "opencode",
        "zen-browser",
        "neovim",
        "obsidian",
        "vscode",
        "zed",
        "heroiclauncher",
        "steam",
        "fastfetch",
        "obs",
        "thunderbird",
        "papirus-icons",
        "bat",
        "fzf",
        "herdr",
        "lazygit",
        "yazi"
    ]

        [theme.templates.user.nvim-base16]
        input_path = "~/.config/nvim/lua/matugen-template.lua"
        output_path = "~/.config/nvim/lua/matugen.lua"
        post_hook = "pkill -SIGUSR1 nvim"

[wallpaper]
directory = "{{ .chezmoi.homeDir }}/Pictures/Wallpaper"
transition = [ "disc", "fade", "stripes", "wipe", "zoom" ]
transition_on_startup = true

    [wallpaper.default]
    path = "{{ .chezmoi.homeDir }}/Pictures/Wallpaper/wallhaven-2yg1lg.png"

    [wallpaper.last]
    path = "{{ .chezmoi.homeDir }}/Pictures/Wallpaper/wallhaven-2yg1lg.png"

{{- if not .laptop }}
    [wallpaper.monitors.DP-1]
    path = "{{ .chezmoi.homeDir }}/Pictures/Wallpaper/wallhaven-2yg1lg.png"

    [wallpaper.monitors.DP-2]
    path = "{{ .chezmoi.homeDir }}/Pictures/Wallpaper/wallhaven-2yg1lg.png"
{{- end }}

    [[wallpaper.favorite]]
    community_palette = "Oxocarbon"
    palette_source = "community"
    path = "{{ .chezmoi.homeDir }}/Pictures/Wallpaper/wallhaven-2yg1lg.png"
    theme_mode = "auto"

    [[wallpaper.favorite]]
    community_palette = "Oxocarbon"
    palette_source = "community"
    path = "{{ .chezmoi.homeDir }}/Pictures/Wallpaper/wallhaven-d6eylg.jpg"
    theme_mode = "dark"

[weather]
refresh_minutes = 120

[widget.audio_visualizer]
bands = 20
show_when_idle = true
width = 180

    [widget.audio_visualizer.actions]
    left = "panel-toggle control-center audio"

[widget.clock]
anchor = false
format = "{:%H:%M:%S}"

    [widget.clock.actions]
    left = "panel-toggle control-center"
    right = "panel-toggle control-center calendar"

[widget.cpu]
visualization = "graph"

[widget.media]
enabled = true
hide_when_no_media = true
title_scroll = "on_hover"

[widget.network]
show_label = false
show_vpn_label = false
vpn_status = "both"

[widget.ram]
visualization = "graph"

[widget.sysmon]
stat = "gpu_usage"
visualization = "graph"

[widget.taskbar]
anchor = true
capsule = false
group_by_workspace = true
hide_empty_workspaces = true
icon_scale = 2.0
inactive_opacity = 0.8
minimal = false
scale = 1.5
show_active_indicator = true
show_window_title = false
workspace_label_placement = "inside"

[widget.tray]
detached_panel = true

[widget.wallhaven]
type = "noctalia/wallhaven:wallhaven"

[widget.workspaces]
empty_color = "tertiary"
hide_when_empty = true
