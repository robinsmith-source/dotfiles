[bar.default]
capsule = true
capsule_radius = 0
center = [ "audio_visualizer", "clock", "media" ]
concave_edge_corners = false
end = [ "tray", "notifications", "group:g2", "volume", "session" ]
font_family = "JetBrainsMono NF"
margin_ends = 0
radius = 0
start = [ "workspaces", "group:g1", "group:g3" ]

    [bar.default.monitor.DP-2]
    center = [ "clock" ]

    [[bar.default.capsule_group]]
    accordion = false
    accordion_direction = "end"
    enabled = true
    fill = "surface_variant"
    id = "g2"
    members = [ "network", "bluetooth" ]
    opacity = 1.0
    padding = 6.0

    [[bar.default.capsule_group]]
    accordion = false
    accordion_direction = "end"
    enabled = true
    fill = "surface_variant"
    id = "g3"
    members = [ "cpu", "ram", "sysmon" ]
    opacity = 1.0
    padding = 6.0
    radius = 0.0

    [[bar.default.capsule_group]]
    accordion = false
    accordion_direction = "end"
    enabled = true
    fill = "surface_variant"
    id = "g1"
    members = [ "wallpaper", "wallhaven" ]
    opacity = 1.0
    padding = 6.0
    radius = 0.0

[calendar]
enabled = true

    [calendar.account.personal_google]
    name = "Personal Calendar"
    type = "google"

[control_center]
{{- if .laptop }}
hidden_tabs = [ ]
{{- else }}
hidden_tabs = [ "monitor", "power" ]
{{- end }}

    [control_center.calendar]
    show_week_numbers = true

    [[control_center.shortcuts]]
    type = "wifi"

    [[control_center.shortcuts]]
    type = "bluetooth"

    [[control_center.shortcuts]]
    type = "notification"

    [[control_center.shortcuts]]
    type = "keyboard_layout"

    [[control_center.shortcuts]]
    type = "audio"

[desktop_widgets]
schema_version = 2
widget_order = [ "desktop-widget-0000000000000001", "desktop-widget-0000000000000002" ]

    [desktop_widgets.grid]
    cell_size = 16
    major_interval = 4
    visible = false

    [desktop_widgets.widget.desktop-widget-0000000000000001]
    box_height = 240.0
    box_width = 576.0
    cx = 3128.0
    cy = 1296.0
    output = "DP-1"
    placement_height = 1440.0
    placement_width = 3440.0
    rotation = 0.0
    type = "clock"

        [desktop_widgets.widget.desktop-widget-0000000000000001.settings]
        background = false
        center_text = true
        clock_style = "digital"
        color = "on_surface"
        font_family = "JetBrainsMono NF"
        shadow = true

    [desktop_widgets.widget.desktop-widget-0000000000000002]
    box_height = 112.0
    box_width = 288.0
    cx = 184.0
    cy = 136.0
    output = "DP-1"
    placement_height = 1440.0
    placement_width = 3440.0
    rotation = 0.0
    type = "weather"

        [desktop_widgets.widget.desktop-widget-0000000000000002.settings]
        background = false
        shadow = true
        show_forecast = false

[dock]
concave_edge_corners = false
enabled = true
icon_size = 36
pinned = [ "spotify-launcher", "discord", "google-chrome" ]
radius = 0
reserve_space = false
show_dots = true
smart_auto_hide = true

[location]
auto_locate = true

[lockscreen_widgets]
enabled = true
schema_version = 2
widget_order = [ "lockscreen-login-box@DP-1", "lockscreen-login-box@DP-2" ]

    [lockscreen_widgets.grid]
    cell_size = 16
    major_interval = 4
    visible = true

    [lockscreen_widgets.widget."lockscreen-login-box@DP-1"]
    box_height = 196.0
    box_width = 810.0
    cx = 1720.0
    cy = 1258.0
    output = "DP-1"
    placement_height = 1440.0
    placement_width = 3440.0
    rotation = 0.0
    type = "login_box"

        [lockscreen_widgets.widget."lockscreen-login-box@DP-1".settings]
        background_color = "surface_variant"
        background_opacity = 0.88
        background_radius = 12.0
        center_password_text = false
        input_opacity = 1.0
        input_radius = 6.0
        layout = "regular"
        show_caps_lock = true
        show_keyboard_layout = true
        show_login_button = true
        show_media = true
        show_session_buttons = true
        show_unlock_hint = false
        show_weather = true

    [lockscreen_widgets.widget."lockscreen-login-box@DP-2"]
    box_height = 196.0
    box_width = 720.0
    cx = 720.0
    cy = 2236.44482421875
    output = "DP-2"
    placement_height = 2560.0
    placement_width = 1440.0
    rotation = 0.0
    type = "login_box"

        [lockscreen_widgets.widget."lockscreen-login-box@DP-2".settings]
        background_color = "surface_variant"
        background_opacity = 0.88
        background_radius = 12.0
        center_password_text = false
        input_opacity = 1.0
        input_radius = 6.0
        layout = "regular"
        show_caps_lock = true
        show_keyboard_layout = true
        show_login_button = true
        show_media = true
        show_session_buttons = true
        show_unlock_hint = true
        show_weather = true

[notification]
filter_order = [ "filter" ]

    [notification.filter.filter]
    allow_permanent = true
    bypass_dnd = false
    enabled = true
    match = "spotify"
    play_sound = true
    save_history = true
    show_toast = true

[osd]
position = "bottom_center"
position_vertical = "bottom_center"

    [osd.kinds]
    keyboard_backlight = false
    media = false
    power_profile = false

[plugins]
enabled = [ "noctalia/bitwarden", "noctalia/wallhaven" ]

[shell]
corner_radius_scale = 0.0
font_family = "JetBrainsMono NF"
niri_overview_type_to_launch_enabled = true
screen_time_enabled = true

    [shell.launcher]
    app_grid = true

    [shell.panel]
    open_near_click_session = true
    transparency_mode = "glass"

[theme]
builtin = "Ayu"
community_palette = "Ayu Red"
mode = "dark"
source = "community"
wallpaper_scheme = "m3-content"

    [theme.templates]
    builtin_ids = [ "alacritty", "btop", "gtk3", "gtk4", "niri", "qt", "starship" ]
    community_ids = [
        "claude-code",
        "opencode",
        "zen-browser",
        "neovim",
        "obsidian",
        "vscode",
        "zed",
        "steam",
        "fastfetch",
        "lazygit"
    ]

    [theme.templates.user.nvim-base16]
    input_path = "~/.config/nvim/lua/matugen-template.lua"
    output_path = "~/.config/nvim/lua/matugen.lua"
    post_hook = "pkill -SIGUSR1 nvim"

[wallpaper.default]
path = "/home/robin/Pictures/wallhaven-ey3jkw.png"

[wallpaper.last]
path = "/home/robin/Pictures/wallhaven-ey3jkw.png"

[wallpaper.monitors.DP-1]
path = "/home/robin/Pictures/wallhaven-ey3jkw.png"

[wallpaper.monitors.DP-2]
path = "/home/robin/Pictures/wallhaven-ey3jkw.png"

[weather]
refresh_minutes = 120

[widget.audio_visualizer]
width = 138

[widget.clock]
anchor = true

    [widget.clock.actions]
    left = "panel-toggle control-center"
    right = "panel-toggle control-center calendar"

[widget.cpu]
visualization = "graph"

[widget.media]
hide_when_no_media = true
title_scroll = "on_hover"

[widget.network]
show_label = false
show_vpn_label = true
vpn_status = "both"

[widget.ram]
visualization = "graph"

[widget.sysmon]
stat = "gpu_usage"
visualization = "graph"

[widget.tray]
detached_panel = true

[widget.wallhaven]
type = "noctalia/wallhaven:wallhaven"

[widget.workspaces]
empty_color = "tertiary"
hide_when_empty = true

[widget.taskbar]
capsule_radius = 3
group_by_workspace = true
inactive_opacity = 0.80000000000000004
minimal = true
scale = 1.5
show_active_indicator = false
show_window_title = false
workspace_label_placement = "inside"
